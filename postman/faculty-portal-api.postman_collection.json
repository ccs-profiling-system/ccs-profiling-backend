{
	"info": {
		"_postman_id": "faculty-portal-api-2024",
		"name": "Faculty Portal API",
		"description": "Complete API collection for Faculty Portal endpoints with automatic authentication",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-refresh token if expired",
					"const tokenExpiry = pm.collectionVariables.get('tokenExpiry');",
					"if (tokenExpiry && Date.now() >= tokenExpiry) {",
					"    console.log('Token expired, please re-login');",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Auto-capture credentials from login response",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    ",
									"    // Store access token",
									"    if (response.data && response.data.accessToken) {",
									"        pm.collectionVariables.set('accessToken', response.data.accessToken);",
									"        console.log('✓ Access token captured');",
									"    }",
									"    ",
									"    // Store refresh token",
									"    if (response.data && response.data.refreshToken) {",
									"        pm.collectionVariables.set('refreshToken', response.data.refreshToken);",
									"        console.log('✓ Refresh token captured');",
									"    }",
									"    ",
									"    // Store user info",
									"    if (response.data && response.data.user) {",
									"        pm.collectionVariables.set('userId', response.data.user.id);",
									"        pm.collectionVariables.set('userEmail', response.data.user.email);",
									"        pm.collectionVariables.set('userRole', response.data.user.role);",
									"        console.log('✓ User info captured');",
									"    }",
									"    ",
									"    // Store faculty ID if available",
									"    if (response.data && response.data.user && response.data.user.facultyId) {",
									"        pm.collectionVariables.set('facultyId', response.data.user.facultyId);",
									"        console.log('✓ Faculty ID captured:', response.data.user.facultyId);",
									"    }",
									"    ",
									"    // Calculate token expiry (assuming 1 hour validity)",
									"    const expiryTime = Date.now() + (60 * 60 * 1000);",
									"    pm.collectionVariables.set('tokenExpiry', expiryTime);",
									"    ",
									"    pm.test('Login successful', () => {",
									"        pm.expect(response.success).to.be.true;",
									"    });",
									"} else {",
									"    pm.test('Login failed', () => {",
									"        pm.expect.fail('Login request failed with status ' + pm.response.code);",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john.doe@ccs.edu\",\n  \"password\": \"pass1234\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "auth", "login"]
						},
						"description": "Login with faculty credentials. Automatically captures access token, refresh token, and user info."
					},
					"response": []
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "auth", "me"]
						},
						"description": "Get current authenticated user information"
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.accessToken) {",
									"        pm.collectionVariables.set('accessToken', response.data.accessToken);",
									"        const expiryTime = Date.now() + (60 * 60 * 1000);",
									"        pm.collectionVariables.set('tokenExpiry', expiryTime);",
									"        console.log('✓ Token refreshed');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "auth", "refresh"]
						},
						"description": "Refresh access token using refresh token"
					},
					"response": []
				},
				{
					"name": "Change Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"currentPassword\": \"oldPassword123\",\n  \"newPassword\": \"newPassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/auth/change-password",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "auth", "change-password"]
						},
						"description": "Change user password"
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "auth", "logout"]
						},
						"description": "Logout current user"
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for login, logout, and token management"
		},
