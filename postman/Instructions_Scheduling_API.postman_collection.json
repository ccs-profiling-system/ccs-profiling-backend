{
  "info": {
    "name": "Instructions & Scheduling API",
    "description": "Complete API collection for Instructions and Scheduling modules - Backend Implementation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1/admin",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Curriculum",
      "item": [
        {
          "name": "Get All Curriculum",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/curriculum?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["curriculum"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"},
                {"key": "search", "value": "", "disabled": true},
                {"key": "program", "value": "", "disabled": true},
                {"key": "year", "value": "", "disabled": true},
                {"key": "status", "value": "", "disabled": true}
              ]
            }
          }
        },
        {
          "name": "Get Curriculum by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/curriculum/:id",
              "host": ["{{base_url}}"],
              "path": ["curriculum", ":id"],
              "variable": [{"key": "id", "value": "curriculum-uuid"}]
            }
          }
        },
        {
          "name": "Create Curriculum",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"BSCS-2024\",\n  \"name\": \"Bachelor of Science in Computer Science\",\n  \"description\": \"Computer Science curriculum for 2024\",\n  \"program\": \"Computer Science\",\n  \"year\": \"2024\",\n  \"totalUnits\": 120,\n  \"effectiveDate\": \"2024-08-01\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/curriculum",
              "host": ["{{base_url}}"],
              "path": ["curriculum"]
            }
          }
        },
        {
          "name": "Update Curriculum",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Curriculum Name\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/curriculum/:id",
              "host": ["{{base_url}}"],
              "path": ["curriculum", ":id"],
              "variable": [{"key": "id", "value": "curriculum-uuid"}]
            }
          }
        },
        {
          "name": "Delete Curriculum (Soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/curriculum/:id",
              "host": ["{{base_url}}"],
              "path": ["curriculum", ":id"],
              "variable": [{"key": "id", "value": "curriculum-uuid"}]
            }
          }
        }
      ]
    },
