    {
      "name": "6. Schedule Occurrences",
      "item": [
        {
          "name": "Get Schedule Occurrences",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/schedules/:scheduleId/occurrences",
              "host": ["{{base_url}}"],
              "path": ["schedules", ":scheduleId", "occurrences"],
              "variable": [{"key": "scheduleId", "value": "schedule-uuid"}]
            }
          }
        },
        {
          "name": "Cancel Occurrence",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Holiday\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/schedules/:scheduleId/occurrences/:occurrenceId/cancel",
              "host": ["{{base_url}}"],
              "path": ["schedules", ":scheduleId", "occurrences", ":occurrenceId", "cancel"],
              "variable": [
                {"key": "scheduleId", "value": "schedule-uuid"},
                {"key": "occurrenceId", "value": "occurrence-uuid"}
              ]
            }
          }
        },
        {
          "name": "Restore Occurrence",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/schedules/:scheduleId/occurrences/:occurrenceId/restore",
              "host": ["{{base_url}}"],
              "path": ["schedules", ":scheduleId", "occurrences", ":occurrenceId", "restore"],
              "variable": [
                {"key": "scheduleId", "value": "schedule-uuid"},
                {"key": "occurrenceId", "value": "occurrence-uuid"}
              ]
            }
          }
        }
