{
  "info": {
    "name": "Chair Portal API",
    "description": "API endpoints for Department Chair Portal - Read-only access to curriculum and subjects data.\n\n## Quick Start\n1. Set the {{base_url}} variable to your server URL (default: http://localhost:3000)\n2. Run the 'Login as Chair' request to authenticate\n3. Access token is automatically saved and used for all subsequent requests\n\n## Environment Variables\n- base_url: http://localhost:3000 (local) or your production URL\n- token: Auto-populated after login\n- curriculum_id: Sample curriculum UUID for testing\n- subject_id: Sample subject UUID for testing\n\n## Authentication\nAll chair endpoints require:\n- Bearer token authentication\n- User must have 'chair' role\n- User must have 'chair.curriculum.read' permission\n\n## Features\n- View curriculum list with pagination and filters\n- View subjects list with pagination and filters\n- Export curriculum to PDF and Excel\n- View curriculum statistics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "curriculum_id",
      "value": "",
      "type": "string",
      "description": "Sample curriculum UUID for testing"
    },
    {
      "key": "subject_id",
      "value": "",
      "type": "string",
      "description": "Sample subject UUID for testing"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically add Authorization header",
          "const token = pm.collectionVariables.get('token');",
          "if (token) {",
          "    pm.request.headers.add({",
          "        key: 'Authorization',",
          "        value: `Bearer ${token}`",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints for chair users",
      "item": [
        {
          "name": "Login as Chair",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data.tokens) {",
                  "        pm.collectionVariables.set('token', response.data.tokens.access.token);",
                  "        console.log('Access token saved to collection variables');",
                  "        console.log('User role:', response.data.user.role);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"chair@ccs.edu\",\n  \"password\": \"pass1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login as a department chair user. User must have 'chair' role and 'chair.curriculum.read' permission."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Curriculum",
      "description": "Curriculum management endpoints - Read-only access for chairs",
      "item": [
        {
          "name": "Get Curriculum List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data.length > 0) {",
                  "        // Save first curriculum ID for other requests",
                  "        pm.collectionVariables.set('curriculum_id', response.data[0].id);",
                  "        console.log('Curriculum ID saved:', response.data[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/chair/curriculum?page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "chair",
                "curriculum"
              ],
              "query": [
